# ==============================================================================
# ActionGate - Node.js Express Gateway Container
# Dockerfile.node
#
# Principal DevOps & Security Engineer Specification:
# Multi-stage, non-root, lightweight production container.
# Minimizes attack surface and eliminates build tools from final runtime image.
# ==============================================================================

# ------------------------------------------------------------------------------
# STAGE 1: Build & Dependency Resolution
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Install build dependencies for native modules if required
RUN apk add --no-cache python3 make g++

# Copy package manifests first to leverage Docker layer caching
COPY package*.json ./

# Install only production dependencies cleanly
RUN npm ci --only=production && npm cache clean --force

# ------------------------------------------------------------------------------
# STAGE 2: Secure Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

# Labels for OCI compliance and auditability
LABEL org.opencontainers.image.title="ActionGate Node.js Gateway" \
      org.opencontainers.image.description="AI Agent Action Authorization Ingress Engine" \
      org.opencontainers.image.vendor="ActionGate Security"

WORKDIR /usr/src/app

ENV NODE_ENV=production \
    PORT=5000

# Install curl for container health check
RUN apk add --no-cache curl

# Copy production node_modules from builder stage
COPY --from=builder /usr/src/app/node_modules ./node_modules

# Copy application source code
COPY . .

# Security Hardening: Run as non-privileged node user (UID 1000)
USER node

# Expose internal Express listening port
EXPOSE 5000

# Health check to ensure service readiness
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5000/api/gateway/metrics || exit 1

# Start Node.js Express server
CMD ["node", "server.js"]
